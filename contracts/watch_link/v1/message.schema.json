{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.beyondrep.invalid/contracts/watch_link/v1/message.schema.json",
  "title": "BeyondRep watch link message, v1",
  "description": "Phone <-> Apple Watch message envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "message_id",
    "type",
    "sent_at_utc",
    "account_key",
    "body"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "enum": [
        "account_binding",
        "account_cleared",
        "plans_snapshot",
        "health_snapshot",
        "workout_event",
        "session_state",
        "session_command",
        "completed_workout",
        "ack",
        "workout_link",
        "join",
        "workout_health"
      ]
    },
    "sent_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "account_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "body": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "account_binding"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/body_account_binding"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "account_cleared"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/body_account_cleared"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "plans_snapshot"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/body_plans_snapshot"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "health_snapshot"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/body_health_snapshot"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "workout_event"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/body_workout_event"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "session_state"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/body_session_state"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "session_command"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/body_session_command"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "completed_workout"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/body_completed_workout"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "ack"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/body_ack"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "workout_link"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/body_workout_link"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "join"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/body_join"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "workout_health"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/body_workout_health"
          }
        }
      }
    }
  ],
  "$defs": {
    "body_account_binding": {
      "type": "object",
      "required": [
        "unit"
      ],
      "additionalProperties": false,
      "properties": {
        "unit": {
          "enum": [
            "kg",
            "lb"
          ]
        }
      }
    },
    "body_account_cleared": {
      "type": "object",
      "required": [
        "wipe_unsent"
      ],
      "additionalProperties": false,
      "properties": {
        "wipe_unsent": {
          "type": "boolean"
        }
      }
    },
    "body_plans_snapshot": {
      "type": "object",
      "required": [
        "generated_at_utc",
        "plans",
        "recent_exercises"
      ],
      "additionalProperties": false,
      "properties": {
        "generated_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "plans": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "plan_id",
              "name",
              "exercises"
            ],
            "additionalProperties": false,
            "properties": {
              "plan_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "exercises": {
                "type": "array",
                "maxItems": 40,
                "items": {
                  "type": "object",
                  "required": [
                    "exercise_id",
                    "name",
                    "kind",
                    "sets"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "exercise_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "kind": {
                      "enum": [
                        "reps",
                        "duration"
                      ]
                    },
                    "muscle": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 60
                    },
                    "sets": {
                      "type": "array",
                      "maxItems": 30,
                      "items": {
                        "type": "object",
                        "required": [
                          "position",
                          "kind"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "position": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "kind": {
                            "enum": [
                              "working",
                              "warmup"
                            ]
                          },
                          "target_reps": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "target_seconds": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "target_load_grams": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "rest_seconds": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 3600
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "today": {
          "type": "object",
          "required": [
            "plan_id",
            "program_id",
            "local_date",
            "label"
          ],
          "additionalProperties": false,
          "properties": {
            "plan_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "program_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "local_date": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          }
        },
        "recent_exercises": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "required": [
              "exercise_id",
              "name",
              "kind"
            ],
            "additionalProperties": false,
            "properties": {
              "exercise_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "kind": {
                "enum": [
                  "reps",
                  "duration"
                ]
              }
            }
          }
        }
      }
    },
    "body_health_snapshot": {
      "type": "object",
      "required": [
        "local_date",
        "as_of_utc"
      ],
      "additionalProperties": false,
      "properties": {
        "local_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "as_of_utc": {
          "type": "string",
          "format": "date-time"
        },
        "readiness": {
          "type": "object",
          "required": [
            "score",
            "band",
            "headline",
            "reason"
          ],
          "additionalProperties": false,
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "band": {
              "enum": [
                "good",
                "fair",
                "low"
              ]
            },
            "headline": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 140
            },
            "factors": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "object",
                "required": [
                  "input",
                  "status",
                  "tone"
                ],
                "additionalProperties": false,
                "properties": {
                  "input": {
                    "enum": [
                      "sleep",
                      "hrv",
                      "resting_hr",
                      "training_load"
                    ]
                  },
                  "status": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 24
                  },
                  "tone": {
                    "enum": [
                      "good",
                      "neutral",
                      "caution"
                    ]
                  }
                }
              }
            }
          }
        },
        "sleep": {
          "type": "object",
          "required": [],
          "additionalProperties": false,
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "asleep_minutes": {
              "type": "integer",
              "minimum": 0
            },
            "deep_minutes": {
              "type": "integer",
              "minimum": 0
            },
            "rem_minutes": {
              "type": "integer",
              "minimum": 0
            },
            "core_minutes": {
              "type": "integer",
              "minimum": 0
            },
            "awake_minutes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "resting_hr_bpm": {
          "type": "integer",
          "minimum": 0
        },
        "hrv_ms": {
          "type": "integer",
          "minimum": 0
        },
        "hrv_kind": {
          "enum": [
            "sdnn",
            "rmssd"
          ]
        },
        "steps": {
          "type": "integer",
          "minimum": 0
        },
        "active_energy_kcal": {
          "type": "integer",
          "minimum": 0
        },
        "resting_hr_usual_bpm": {
          "type": "integer",
          "minimum": 0
        },
        "hrv_usual_ms": {
          "type": "integer",
          "minimum": 0
        },
        "week": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "items": {
            "type": "object",
            "required": [
              "local_date"
            ],
            "additionalProperties": false,
            "properties": {
              "local_date": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "asleep_minutes": {
                "type": "integer",
                "minimum": 0
              },
              "sleep_score": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "resting_hr_bpm": {
                "type": "integer",
                "minimum": 0
              },
              "hrv_ms": {
                "type": "integer",
                "minimum": 0
              },
              "steps": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "body_workout_event": {
      "type": "object",
      "required": [
        "event"
      ],
      "additionalProperties": false,
      "properties": {
        "event": {
          "$ref": "../../workout_sync/v2/envelope.schema.json"
        }
      }
    },
    "body_session_state": {
      "type": "object",
      "required": [
        "session_id",
        "owner",
        "status",
        "name",
        "started_at_utc",
        "last_sequence",
        "exercises"
      ],
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "owner": {
          "enum": [
            "watch",
            "phone"
          ]
        },
        "status": {
          "enum": [
            "active",
            "paused",
            "ended"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "started_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "last_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "current_set_id": {
          "type": "string",
          "format": "uuid"
        },
        "rest_deadline_utc": {
          "type": "string",
          "format": "date-time"
        },
        "end_reason": {
          "enum": [
            "completed",
            "discarded"
          ]
        },
        "paused_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "paused_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "applied_command_ids": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "rejected_commands": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "command_id",
              "reason"
            ],
            "additionalProperties": false,
            "properties": {
              "command_id": {
                "type": "string",
                "format": "uuid"
              },
              "reason": {
                "enum": [
                  "unknown_session",
                  "unknown_set",
                  "invalid_values",
                  "not_allowed"
                ]
              }
            }
          }
        },
        "exercises": {
          "type": "array",
          "maxItems": 120,
          "items": {
            "type": "object",
            "required": [
              "exercise_id",
              "name",
              "kind",
              "sets"
            ],
            "additionalProperties": false,
            "properties": {
              "exercise_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "kind": {
                "enum": [
                  "reps",
                  "duration"
                ]
              },
              "sets": {
                "type": "array",
                "maxItems": 300,
                "items": {
                  "type": "object",
                  "required": [
                    "set_id",
                    "position",
                    "kind",
                    "status"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "set_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "position": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "kind": {
                      "enum": [
                        "working",
                        "warmup"
                      ]
                    },
                    "status": {
                      "enum": [
                        "planned",
                        "completed",
                        "skipped"
                      ]
                    },
                    "input_unit": {
                      "enum": [
                        "kg",
                        "lb"
                      ]
                    },
                    "reps": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "duration_seconds": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "load_grams": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "rpe": {
                      "type": "number",
                      "minimum": 1,
                      "maximum": 10,
                      "multipleOf": 0.5
                    },
                    "rest_seconds": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 3600
                    }
                  }
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ended"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "end_reason"
            ]
          },
          "else": {
            "not": {
              "required": [
                "end_reason"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "paused"
              }
            },
            "required": [
              "status"
            ]
          },
          "else": {
            "not": {
              "required": [
                "paused_at_utc"
              ]
            }
          }
        }
      ]
    },
    "body_session_command": {
      "type": "object",
      "required": [
        "session_id",
        "command_id",
        "command"
      ],
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "command_id": {
          "type": "string",
          "format": "uuid"
        },
        "command": {
          "enum": [
            "log_set",
            "correct_set",
            "skip_set",
            "add_set",
            "start_rest",
            "clear_rest",
            "pause",
            "resume",
            "finish",
            "discard"
          ]
        },
        "set": {
          "type": "object",
          "required": [
            "set_id",
            "exercise_id",
            "position",
            "kind",
            "input_unit"
          ],
          "additionalProperties": false,
          "properties": {
            "set_id": {
              "type": "string",
              "format": "uuid"
            },
            "exercise_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "position": {
              "type": "integer",
              "minimum": 0
            },
            "kind": {
              "enum": [
                "working",
                "warmup"
              ]
            },
            "input_unit": {
              "enum": [
                "kg",
                "lb"
              ]
            },
            "reps": {
              "type": "integer",
              "minimum": 0
            },
            "duration_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "load_grams": {
              "type": "integer",
              "minimum": 0
            },
            "rpe": {
              "type": "number",
              "minimum": 1,
              "maximum": 10,
              "multipleOf": 0.5
            }
          }
        },
        "rest_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "exercise_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "command": {
                "enum": [
                  "log_set",
                  "correct_set",
                  "skip_set"
                ]
              }
            },
            "required": [
              "command"
            ]
          },
          "then": {
            "required": [
              "set"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "command": {
                "const": "add_set"
              }
            },
            "required": [
              "command"
            ]
          },
          "then": {
            "required": [
              "exercise_id"
            ]
          },
          "else": {
            "not": {
              "required": [
                "exercise_id"
              ]
            }
          }
        }
      ]
    },
    "body_completed_workout": {
      "type": "object",
      "required": [
        "workout",
        "last_sequence"
      ],
      "additionalProperties": false,
      "properties": {
        "workout": {
          "$ref": "#/$defs/cloud_workout"
        },
        "last_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "healthkit_workout_uuid": {
          "type": "string",
          "format": "uuid"
        },
        "program_day": {
          "type": "object",
          "required": [
            "plan_id",
            "program_id",
            "local_date"
          ],
          "additionalProperties": false,
          "properties": {
            "plan_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "program_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "local_date": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          }
        }
      }
    },
    "body_ack": {
      "type": "object",
      "required": [
        "acked_message_id",
        "result"
      ],
      "additionalProperties": false,
      "properties": {
        "acked_message_id": {
          "type": "string",
          "format": "uuid"
        },
        "result": {
          "enum": [
            "stored",
            "duplicate",
            "rejected"
          ]
        },
        "reason": {
          "enum": [
            "wrong_account",
            "invalid",
            "unsupported_version",
            "not_written"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "const": "not_written"
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "const": "rejected"
              }
            }
          }
        }
      ]
    },
    "cloud_workout": {
      "type": "object",
      "required": [
        "schema_version",
        "workout_id",
        "origin",
        "status",
        "name",
        "started_at_utc",
        "completed_at_utc",
        "original_offset_minutes",
        "exercises"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "workout_id": {
          "type": "string",
          "format": "uuid"
        },
        "origin": {
          "const": "beyondrep_watch"
        },
        "status": {
          "const": "completed"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "started_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "original_offset_minutes": {
          "type": "integer",
          "minimum": -840,
          "maximum": 840
        },
        "exercises": {
          "type": "array",
          "maxItems": 120,
          "items": {
            "$ref": "#/$defs/cloud_exercise"
          }
        }
      }
    },
    "cloud_exercise": {
      "type": "object",
      "required": [
        "id",
        "name",
        "position",
        "sets"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "position": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "muscle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "equipment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "primary_muscles": {
          "type": "array",
          "maxItems": 14,
          "uniqueItems": true,
          "items": {
            "enum": [
              "chest",
              "shoulders",
              "biceps",
              "forearms",
              "abs",
              "obliques",
              "quads",
              "calves",
              "traps",
              "lats",
              "lowerBack",
              "triceps",
              "glutes",
              "hamstrings"
            ]
          }
        },
        "secondary_muscles": {
          "type": "array",
          "maxItems": 14,
          "uniqueItems": true,
          "items": {
            "enum": [
              "chest",
              "shoulders",
              "biceps",
              "forearms",
              "abs",
              "obliques",
              "quads",
              "calves",
              "traps",
              "lats",
              "lowerBack",
              "triceps",
              "glutes",
              "hamstrings"
            ]
          }
        },
        "sets": {
          "type": "array",
          "maxItems": 300,
          "items": {
            "type": "object",
            "required": [
              "id",
              "position",
              "kind",
              "status",
              "input_unit"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "position": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "kind": {
                "enum": [
                  "working",
                  "warmup"
                ]
              },
              "status": {
                "enum": [
                  "planned",
                  "completed",
                  "skipped"
                ]
              },
              "input_unit": {
                "enum": [
                  "kg",
                  "lb"
                ]
              },
              "reps": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "duration_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 86400
              },
              "load_grams": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000000
              },
              "rpe": {
                "type": "number",
                "minimum": 0,
                "maximum": 10,
                "multipleOf": 0.5
              },
              "completed_at_utc": {
                "type": "string",
                "format": "date-time"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "completed"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "required": [
                    "completed_at_utc"
                  ],
                  "anyOf": [
                    {
                      "required": [
                        "reps"
                      ]
                    },
                    {
                      "required": [
                        "duration_seconds"
                      ]
                    }
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "reps",
                    "duration_seconds"
                  ]
                }
              }
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "secondary_muscles"
            ],
            "properties": {
              "secondary_muscles": {
                "minItems": 1
              }
            }
          },
          "then": {
            "required": [
              "primary_muscles"
            ],
            "properties": {
              "primary_muscles": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "body_workout_link": {
      "type": "object",
      "required": [
        "workout_id",
        "healthkit_workout_uuid"
      ],
      "additionalProperties": false,
      "properties": {
        "workout_id": {
          "type": "string",
          "format": "uuid"
        },
        "healthkit_workout_uuid": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "body_join": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "body_workout_health": {
      "type": "object",
      "required": [
        "workout_id",
        "start_utc",
        "end_utc",
        "heart_rate"
      ],
      "additionalProperties": false,
      "properties": {
        "workout_id": {
          "type": "string",
          "format": "uuid"
        },
        "start_utc": {
          "type": "string",
          "format": "date-time"
        },
        "end_utc": {
          "type": "string",
          "format": "date-time"
        },
        "heart_rate": {
          "type": "array",
          "maxItems": 600,
          "items": {
            "type": "object",
            "required": [
              "at_utc",
              "bpm"
            ],
            "additionalProperties": false,
            "properties": {
              "at_utc": {
                "type": "string",
                "format": "date-time"
              },
              "bpm": {
                "type": "integer",
                "minimum": 25,
                "maximum": 250
              }
            }
          }
        },
        "total_kcal": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        }
      }
    }
  }
}
