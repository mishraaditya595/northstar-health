---
import { SITE } from '../site';

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD objects for this page; Organization is added on every page. */
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, jsonLd = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), SITE.url).href;
const ogImage = new URL('/og.jpg', SITE.url).href;
const fullTitle = title === SITE.name ? `${SITE.name}: Offline Strength Training Log for iPhone and Android` : `${title} | ${SITE.name}`;

const graph = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
    logo: new URL('/icon-512.png', SITE.url).href,
    email: SITE.contactEmail,
  },
  ...jsonLd.map((item) => ({ '@context': 'https://schema.org', ...item })),
];
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
{graph.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
