---
import Base from '../layouts/Base.astro';
import GetApp from '../components/GetApp.astro';
import { SITE } from '../site';
import CinematicIntro from '../components/CinematicIntro.astro';
import Backdrop from '../components/Backdrop.astro';
import '../styles/home-sections.css';
import '../styles/home-scenes.css';

const faqs = [
  {
    q: 'Does BeyondRep work without internet?',
    a: 'Yes. Once you have signed in, you can plan, log and finish workouts with no signal. Everything is saved on your phone first, and finished workouts back up the next time you are online.',
  },
  {
    q: 'Why do I need an account?',
    a: 'Your account is how your finished workouts are backed up and restored on a new phone. Sign-in uses a one-time code sent to your email. There are no passwords and no social logins.',
  },
  {
    q: 'What gets backed up to the cloud?',
    a: 'Only workouts you have finished, with their exercises and sets. Unfinished sessions, your plans and templates, and any Apple Health or Health Connect data stay on your phone.',
  },
  {
    q: 'Does BeyondRep read my health data?',
    a: 'Only if you tap Connect. It then reads your sleep, heart, activity and body measurements to show a daily summary, trends and an energy score. Those values are never saved to disk or sent anywhere.',
  },
  {
    q: 'Can I take my data with me or delete it?',
    a: 'Yes. You can export your backed-up workouts as a JSON file, delete single workouts, or delete your whole account from inside the app.',
  },
  {
    q: 'Is BeyondRep available yet?',
    a: 'Not yet. It is in private testing on iPhone. Use the button above to get an email when it launches on iPhone, iPad and Android.',
  },
];

// Seven sample daily energy scores, drawn as a sparkline (viewBox 140 x 48).
const energyTrend = [62, 68, 59, 71, 66, 79, 74];
const trendPoints = energyTrend
  .map((v, i) => `${((i / (energyTrend.length - 1)) * 140).toFixed(1)},${(44 - ((v - 55) / 28) * 38).toFixed(1)}`)
  .join(' ');

const jsonLd = [
  {
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<Base
  title="BeyondRep"
  description="BeyondRep is a strength-training log for iPhone and Android that works offline, backs up only your finished workouts, and shows your sleep and recovery beside your training."
  jsonLd={jsonLd}
  cinematic
>
  <CinematicIntro />
  <Backdrop />
  <div class="seam" aria-hidden="true"></div>

  <section id="details" class="feature" data-backdrop="lime" aria-labelledby="offline">
    <div class="wrap split scene-split">
      <div class="copy">
        <div class="split-head" data-reveal>
          <p class="kicker">Offline first</p>
          <h2 class="display" id="offline" data-words>Built for the gym, not for signal bars</h2>
          <p class="section-lede">
            Basements, garages and hotel gyms rarely have good coverage. BeyondRep never waits on the network to save a
            set.
          </p>
        </div>
        <ul class="points" data-reveal>
          <li><span class="tag">Saved locally first</span><h3>Nothing to lose mid-workout</h3><p>Each set is written to your phone the moment you tick it, so a dead zone or a crash costs you nothing.</p></li>
          <li><span class="tag">Backs up later</span><h3>Syncs when you’re back online</h3><p>Finished workouts queue up and back up when you reconnect. You can see what is still waiting to back up.</p></li>
          <li><span class="tag">Multi-device</span><h3>New phone, same history</h3><p>Sign in on another phone and your finished workouts come back. If two phones disagree, you choose which version to keep.</p></li>
        </ul>
      </div>
      <div class="demo-track" data-scene-track="offline">
        <div data-scene-stage>
          <div class="demo demo-offline" data-reveal data-glow aria-hidden="true">
            <div class="demo-head">
              <span class="demo-title">Bench press</span>
              <span class="signal" aria-hidden="true"><i style="--k:1"></i><i style="--k:2"></i><i style="--k:3"></i><i style="--k:4"></i></span>
              <span class="chip chip-offline">No signal</span>
              <span class="chip chip-online">Backed up</span>
            </div>
            <div class="set-row" data-n="1"><b>1</b><span>60 kg × 8</span><em>Saved on phone</em><i>✓</i></div>
            <div class="set-row" data-n="2"><b>2</b><span>70 kg × 6</span><em>Saved on phone</em><i>✓</i></div>
            <div class="set-row" data-n="3"><b>3</b><span>70 kg × 6</span><em>Saved on phone</em><i>✓</i></div>
            <div class="sync">
              <div class="sync-text"><span class="sync-wait">Finished workout waiting to back up</span><span class="sync-done">Finished workout backed up</span></div>
              <div class="sync-bar"><i></i></div>
            </div>
            <p class="demo-note">Illustration · sample values</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="feature" data-backdrop="lime" aria-labelledby="train">
    <div class="wrap">
      <div data-scene-track="training">
        <div data-scene-stage>
          <div class="train-head" data-reveal>
            <p class="kicker">Training</p>
            <h2 class="display" id="train" data-words>Plan it, lift it, see it add up</h2>
            <p class="section-lede">The tools you reach for every session, without the clutter.</p>
          </div>
          <div class="tiles">
            <div class="tile" data-scene-track="tile-1" data-scene-mode="cross" data-reveal data-glow style="--i:0;--n:1">
              <div class="viz viz-library" aria-hidden="true">
                <div class="search">Search exercises</div>
                <div class="chips"><span>Chest</span><span>Dumbbell</span><span>Barbell</span></div>
                <div class="result" style="--j:0">Incline dumbbell press</div>
                <div class="result" style="--j:1">Barbell bench press</div>
                <div class="result" style="--j:2">Cable fly</div>
              </div>
              <h3>Plans and an exercise library</h3>
              <p>Build your own routines from an exercise catalog you can search by name, muscle or equipment, or add your own.</p>
            </div>
            <div class="tile" data-scene-track="tile-2" data-scene-mode="cross" data-reveal data-glow style="--i:1;--n:2">
              <div class="viz viz-program" aria-hidden="true">
                <div class="week">{['M', 'T', 'W', 'T', 'F', 'S', 'S'].map((d, j) => <span class={j === 0 || j === 2 ? 'done' : j === 3 ? 'today' : ''} style={`--j:${j}`}>{d}</span>)}</div>
                <div class="today-card"><small>Today</small><b>Upper body A</b><span>6 exercises</span></div>
              </div>
              <h3>Programs with a plan for today</h3>
              <p>Follow a multi-week program and today’s workout is waiting on your Today screen. Miss a day and you can still start it later.</p>
            </div>
            <div class="tile" data-scene-track="tile-3" data-scene-mode="cross" data-reveal data-glow style="--i:2;--n:3">
              <div class="viz viz-log" aria-hidden="true">
                <div class="log-last">Last time <b>65 kg × 8</b></div>
                <div class="log-now"><span class="big"><span data-kg>70</span><small>kg</small></span><span class="times">×</span><span class="big"><span data-reps>6</span><small>reps</small></span></div>
                <div class="log-unit"><span class="on">kg</span><span>lb</span></div>
              </div>
              <h3>Fast set logging</h3>
              <p>Log weight, reps and RPE in kg or lb, with last session’s numbers shown next to each set.</p>
            </div>
            <div class="tile" data-scene-track="tile-4" data-scene-mode="cross" data-reveal data-glow style="--i:3;--n:4">
              <div class="viz viz-timer" aria-hidden="true">
                <svg viewBox="0 0 120 120"><circle class="track" cx="60" cy="60" r="50" /><circle class="ring" cx="60" cy="60" r="50" pathLength="100" /></svg>
                <div class="timer-text"><b>01:28</b><span>Rest</span></div>
              </div>
              <h3>Rest timer</h3>
              <p>Finish a set and the rest timer starts, so you know when to go again.</p>
            </div>
            <div class="tile" data-scene-track="tile-5" data-scene-mode="cross" data-reveal data-glow style="--i:4;--n:5">
              <div class="viz viz-progress" aria-hidden="true">
                <div class="bars">{[42, 64, 38, 80, 55, 92, 70].map((h, j) => <i style={`height:${h}%;--j:${j}`}></i>)}</div>
                <div class="muscles"><span style="--j:0">Chest</span><span style="--j:1">Back</span><span style="--j:2">Legs</span></div>
              </div>
              <h3>Progress and recovery map</h3>
              <p>Workout history and weekly volume and training-time trends, plus a body map of which muscle groups you have trained in the last 72 hours.</p>
            </div>
          </div>
          <p class="demo-note train-note">Illustration · sample values</p>
        </div>
      </div>
    </div>
  </section>

  <section class="feature" data-backdrop="violet" aria-labelledby="health">
    <div class="wrap split split-flip scene-split">
      <div class="copy">
        <div class="split-head" data-reveal>
          <p class="kicker kicker-sleep">Recovery</p>
          <h2 class="display" id="health" data-words>Your recovery, next to your training</h2>
          <p class="section-lede">
            Connect Apple Health or Health Connect and BeyondRep shows your sleep, an energy score and 7 and 30-day
            trends beside your training. It reads; it never uploads your health data.
          </p>
        </div>
        <ul class="points" data-reveal>
          <li><span class="tag tag-sleep">Sleep</span><h3>Last night’s sleep</h3><p>How long you slept, so you can decide whether to push or hold back today.</p></li>
          <li><span class="tag tag-sleep">Energy</span><h3>An energy score for right now</h3><p>Worked out on your phone from your sleep, heart and recent training, so you can decide whether to push or hold back. It is never stored or sent anywhere.</p></li>
          <li><span class="tag">Daily signals</span><h3>Steps, resting heart rate and weight</h3><p>Today’s steps, your latest resting heart rate and your latest weight, each with its date. Missing data is shown as missing, never as zero.</p></li>
        </ul>
      </div>
      <div class="demo-track" data-scene-track="recovery">
        <div data-scene-stage>
          <div class="demo demo-health" data-reveal data-glow aria-hidden="true">
            <div class="sleep">
              <span class="demo-label">Last night’s sleep</span>
              <b>7h 24m</b>
              <div class="wave">{[40, 72, 55, 95, 35, 62, 88, 46, 70, 38, 58, 30].map((h, j) => <i style={`height:${h}%;--j:${j}`}></i>)}</div>
            </div>
            <div class="energy">
              <div class="gauge">
                <svg viewBox="0 0 100 100"><circle class="track" cx="50" cy="50" r="42" /><circle class="arc" cx="50" cy="50" r="42" pathLength="100" /></svg>
                <b data-energy-value>74</b>
              </div>
              <div class="energy-trend">
                <span class="demo-label">Energy · sample</span>
                <svg viewBox="0 0 140 48"><polyline pathLength="100" points={trendPoints} /></svg>
                <small>Last 7 days</small>
              </div>
            </div>
            <div class="stats">
              <div><span class="demo-label">Steps</span><b data-steps>6,240</b><small>Today</small></div>
              <div><span class="demo-label">Resting HR</span><b><span data-rhr>58</span> bpm</b><small>Today</small></div>
              <div><span class="demo-label">Weight</span><b class="missing">No reading</b><small>Shown as missing, not zero</small></div>
            </div>
            <p class="demo-note">Illustration · sample values</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="feature" data-backdrop="teal" aria-labelledby="privacy">
    <div class="wrap">
      <div data-scene-track="privacy">
        <div data-scene-stage>
          <div data-reveal>
            <p class="kicker">Privacy</p>
            <h2 class="display" id="privacy" data-words>Your data stays yours</h2>
            <p class="section-lede">We back up the minimum needed to keep your training safe, and we say exactly what that is.</p>
          </div>
          <div class="cards">
            <div class="phone-outline" aria-hidden="true"></div>
            <div class="panel vault" data-reveal data-glow style="--i:0">
              <svg class="vault-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 18a4.5 4.5 0 0 1-.5-8.97A6 6 0 0 1 18 8.5a4.75 4.75 0 0 1-.5 9.5z" /></svg>
              <h3>Stored with your account</h3>
              <ul class="checklist">
                <li>Your email address, for sign-in codes</li>
                <li>Workouts you have finished, with their exercises and sets</li>
              </ul>
            </div>
            <div class="panel vault vault-phone" data-reveal data-glow style="--i:1">
              <svg class="vault-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="7" y="2.5" width="10" height="19" rx="2.5" /><path d="M10.5 18.5h3" /></svg>
              <svg class="vault-lock" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="9.5" rx="2.2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg>
              <h3>Never leaves your phone</h3>
              <ul class="checklist no">
                <li>Apple Health and Health Connect data</li>
                <li>Unfinished workouts, plans and templates</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
      <p class="muted" data-reveal>
        No ads, no analytics, no tracking and no selling of data. Export your backed-up workouts as a file or delete your account from inside the app at any time.{' '}
        <a href="/privacy">Read the privacy policy</a>.
      </p>
    </div>
  </section>

  <section class="feature" data-backdrop="teal" aria-labelledby="faq">
    <div class="wrap narrow">
      <h2 class="display" id="faq" data-reveal>Questions</h2>
      <div class="faq">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="feature" data-backdrop="lime" aria-labelledby="cta">
    <div class="wrap">
      <div data-scene-track="finale">
        <div data-scene-stage>
          <div class="hero finale" data-reveal>
            <div class="finale-rings" aria-hidden="true"><i></i><i></i><i></i></div>
            <div class="hero-grid" style="grid-template-columns:1fr">
              <div>
                <h2 class="finale-title" id="cta"><span class="ft-a" data-words>Show up.</span> <span class="ft-b" data-words>Get strong.</span></h2>
                <p class="lede">Be first to know when BeyondRep is out.</p>
                <GetApp />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <script>
    import { mountReveals, mountWords, mountMagnets } from '../scripts/home-reveal.mjs';
    import { mountScenes } from '../scripts/scroll-scenes.mjs';
    import { frames } from '../scripts/scenes/index.mjs';
    import { mountPrivacyOffsets } from '../scripts/scenes/privacy.mjs';
    mountReveals(document, window);
    mountWords(document, window);
    mountMagnets(document, window);
    mountScenes(document, window, frames);
    mountPrivacyOffsets(document, window);
  </script>
</Base>
