---
import Base from './Base.astro';
import { SITE } from '../site';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---
<Base title={title} description={description}>
  <article class="wrap narrow prose">
    <h1>{title}</h1>
    <p class="muted">Last updated {SITE.legalLastUpdated}</p>
    {SITE.legalDraft && (
      <div class="callout" role="note">
        <p><strong>Draft.</strong> This page is being finalised before BeyondRep’s public release. It describes how the app works today, but some details below are still marked as to be confirmed.</p>
      </div>
    )}
    <slot />
  </article>
</Base>
