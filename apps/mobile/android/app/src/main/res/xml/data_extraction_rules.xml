<?xml version="1.0" encoding="utf-8"?>
<!-- Prevent cloud and device-to-device migration of sensitive ObjectBox history.
     This is intentional until an explicit, authenticated backup flow is shipped. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
